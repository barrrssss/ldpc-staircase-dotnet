<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps the reach erasure16-dotnet has (including .NET Framework).
         net8.0 exists only so the symbol XOR - the decoder's hot loop - can use a safe
         wide span view; see Symbols.XorInto. Both produce identical bytes. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>LdpcStaircase</RootNamespace>
    <AssemblyName>LdpcStaircase</AssemblyName>
    <PackageId>LdpcStaircase</PackageId>
    <Version>0.1.3</Version>
    <Authors>barrrssss</Authors>
    <Title>LDPC Staircase</Title>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Systematic, fixed-rate LDPC-Staircase erasure code over GF(2), following the RFC 5170 section 6 core. Abstract: symbol bytes in, symbol bytes out.</Description>
    <PackageTags>ldpc;erasure-coding;fec;forward-error-correction;rfc5170</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/barrrssss/ldpc-staircase-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/barrrssss/ldpc-staircase-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
